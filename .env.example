# Salin jadi .env.local lalu isi dari dashboard Supabase (Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) — HANYA dipakai server (cron reminder). Jangan pernah diberi prefix NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# Token device dari dashboard Fonnte
FONNTE_TOKEN=

# String acak bebas, dipakai Vercel Cron untuk otentikasi endpoint reminder
CRON_SECRET=
