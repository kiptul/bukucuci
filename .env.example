# Salin berkas ini jadi .env.local, lalu isi dari dashboard Supabase.
# Jangan pernah menulis nilai sungguhan di berkas ini — ia ikut masuk git.

# --- Supabase ---
# Settings > API. Keduanya ikut terkirim ke browser, memang begitu rancangannya:
# yang menjaga data adalah RLS, bukan kerahasiaan kunci ini.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Settings > API, bagian secret. Kunci ini MENEMBUS SELURUH RLS.
# Hanya boleh dipakai di server, di balik pastikanSuperAdmin(). Jangan pernah
# diberi awalan NEXT_PUBLIC_ — itu akan mengirimkannya ke browser.
SUPABASE_SECRET_KEY=

# --- WhatsApp (Fonnte) ---
# Token perangkat dari dashboard Fonnte.
FONNTE_TOKEN=

# --- Cron ---
# String acak bebas. Dipakai memastikan /api/cron/reminder hanya bisa dipanggil
# penjadwal Vercel, bukan sembarang orang. Buat dengan: openssl rand -hex 24
CRON_SECRET=

# --- Modul rak IoT (boleh dikosongkan kalau tidak memakai rak) ---
# id baris di tabel laundry: select id from laundry limit 1;
LAUNDRY_ID=
# String acak panjang, harus sama persis dengan yang ditulis di
# perangkat/esp32_kelar/esp32_kelar.ino. Buat dengan: openssl rand -hex 24
DEVICE_TOKEN=
